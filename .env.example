# ==============================================================================
# FlowPilot Backend — Environment Variable Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` in the `flowpilot-backend` root directory.
# NEVER commit the actual `.env` file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'test', or 'production'
NODE_ENV=development
# Port on which the Express HTTP server listens
PORT=4000
# Host address to bind to ('0.0.0.0' for containers/cloud hosts, '127.0.0.1' for local only)
HOST=0.0.0.0
# Reverse Proxy Trust Configuration:
# - 'false': Local development without reverse proxy
# - '1': Single hop reverse proxy (e.g., Render, Railway, AWS ALB, Nginx)
# - Subnet/CIDR: Specific trusted proxy IP ranges
TRUST_PROXY=false
# Application log level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace', 'silent'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORS & Client Routing
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Wildcard '*' is strictly rejected in credentialed mode.
CORS_ORIGIN=http://localhost:3000
# Canonical Frontend Application URL (used in email links, password reset, invitations)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Database & Connection Pooling
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (Supabase, AWS RDS, local PostgreSQL, etc.)
# For Supabase with PgBouncer connection pooler in production:
# DATABASE_URL=postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://flowpilot:flowpilot_password@localhost:5432/flowpilot_dev?schema=public

# ------------------------------------------------------------------------------
# 4. Security, Authentication & Session Secrets
# ------------------------------------------------------------------------------
# Cryptographic secret used to sign session cookies. MUST be at least 32 characters.
# In production, default dev keys are strictly rejected. Generate using: `openssl rand -hex 32`
COOKIE_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
# Session duration in days
SESSION_EXPIRY_DAYS=7

# ------------------------------------------------------------------------------
# 5. Rate Limiting Safeguards
# ------------------------------------------------------------------------------
# Time window for rate limiting in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum number of general API requests allowed per window per IP
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 6. Transactional Email Infrastructure (M2)
# ------------------------------------------------------------------------------
# Email provider selection: 'auto', 'smtp', 'resend', 'sendgrid', 'postmark', 'test', 'console'
EMAIL_PROVIDER=auto
# Sender identity
EMAIL_FROM="FlowPilot Security <noreply@flowpilot.io>"
EMAIL_REPLY_TO="support@flowpilot.io"

# SMTP Settings (Active when EMAIL_PROVIDER=smtp or auto with SMTP_USER set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_specific_password
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

# Alternative API-based Email Providers (Free-tier friendly)
RESEND_API_KEY=
SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=

# Email Delivery Retry Settings
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_INITIAL_DELAY_MS=500

# ------------------------------------------------------------------------------
# 7. SaaS Subscriptions & Stripe Payments (M4)
# ------------------------------------------------------------------------------
# Stripe API Keys (Test Mode for development/staging: sk_test_..., pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Subscription Price & Product IDs (Optional overrides; defaults provided in registry)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUALLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUALLY=
STRIPE_PRODUCT_PRO=
STRIPE_PRODUCT_ENTERPRISE=

# ------------------------------------------------------------------------------
# 8. Cloud Storage Infrastructure (M5)
# ------------------------------------------------------------------------------
# Storage provider selection: 'auto', 'supabase', 's3', 'local', 'memory'
# NOTE: 'local' and 'memory' are strictly rejected in NODE_ENV=production.
STORAGE_PROVIDER=auto
# Public and private storage bucket names
STORAGE_BUCKET_PUBLIC=flowpilot-public
STORAGE_BUCKET_PRIVATE=flowpilot-private
# Local storage filesystem root (used only in development/test with STORAGE_PROVIDER=local)
STORAGE_LOCAL_ROOT=uploads
# Expiration time for private signed file URLs in seconds (default: 900 = 15 minutes)
STORAGE_SIGNED_URL_EXPIRY_SECONDS=900
# Cryptographic secret for signing private HMAC file URLs (min 32 chars)
STORAGE_SIGNING_SECRET=replace_with_a_secure_signing_secret_at_least_32_chars_long

# Supabase Storage Configuration (Primary Free-Tier Cloud Storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AWS S3 / S3-Compatible Cloud Storage Configuration (Alternative)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
