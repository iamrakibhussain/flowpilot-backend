# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# CORS Configuration (comma-separated origins, no wildcards allowed)
CORS_ORIGIN=http://localhost:3000

# Reverse Proxy Trust (false for local dev, 1 for single proxy/ALB, or CIDR)
TRUST_PROXY=false

# Database Configuration (PostgreSQL connection string)
DATABASE_URL=postgresql://flowpilot:flowpilot_password@localhost:5432/flowpilot_dev?schema=public

# Security & Sessions (Must be unique 32+ char key in production)
COOKIE_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
SESSION_EXPIRY_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Frontend Application URL (used for password reset links)
FRONTEND_URL=http://localhost:3000

# Transactional Email (SMTP) Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="FlowPilot <noreply@flowpilot.com>"
