datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  BILLING
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CustomerStatus {
  ACTIVE
  LEAD
  INACTIVE
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
  PENDING
}

enum AppointmentType {
  VIDEO
  IN_PERSON
  PHONE
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
  CANCELLED
}

enum StaffStatus {
  AVAILABLE
  IN_SESSION
  ON_BREAK
  OFFLINE
}

enum StaffTier {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  name            String
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  memberships            Membership[]
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationCodes EmailVerificationCode[]
  staffMembers           StaffMember[]
  sentInvitations        OrganizationInvitation[] @relation("SentInvitations")

  @@map("users")
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  status         OrganizationStatus @default(ACTIVE)
  bookingEnabled Boolean            @default(true) @map("booking_enabled")
  bookingTitle   String?            @map("booking_title")
  bookingNotice  String?            @map("booking_notice")

  // Brand & Public Portal
  logoUrl        String?            @map("logo_url")
  tagline        String?
  brandColor     String?            @default("#2563eb") @map("brand_color")
  customDomain   String?            @unique @map("custom_domain")
  contactEmail   String?            @map("contact_email")
  contactPhone   String?            @map("contact_phone")
  address        String?

  // Financial Localization & Defaults
  currency            String         @default("USD")
  timezone            String         @default("UTC")
  taxId               String?        @map("tax_id")
  defaultTaxRate      Float          @default(0.0) @map("default_tax_rate")
  defaultPaymentTerms String         @default("NET_15") @map("default_payment_terms")
  invoiceFooter       String?        @map("invoice_footer")

  // Bank Remittance Coordinates
  bankName        String?            @map("bank_name")
  bankAccount     String?            @map("bank_account")
  bankRouting     String?            @map("bank_routing")
  bankSwift       String?            @map("bank_swift")

  // Scheduling & Policy Controls
  minNoticeHours      Int            @default(2) @map("min_notice_hours")
  maxHorizonDays      Int            @default(30) @map("max_horizon_days")
  cancellationHours   Int            @default(24) @map("cancellation_hours")
  autoConfirmBookings Boolean        @default(true) @map("auto_confirm_bookings")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  memberships         Membership[]
  customers           Customer[]
  services            Service[]
  staffMembers        StaffMember[]
  appointments        Appointment[]
  invoices            Invoice[]
  paymentSettings     OrganizationPaymentSettings?
  paymentTransactions PaymentTransaction[]
  customerPortalTokens   CustomerPortalToken[]
  customerPortalSessions CustomerPortalSession[]
  invitations         OrganizationInvitation[]
  auditLogs           WorkspaceAuditLog[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationCode {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

model Customer {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  name           String
  email          String
  phone          String?
  company        String?
  status         CustomerStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments        Appointment[]
  invoices            Invoice[]
  paymentTransactions PaymentTransaction[]
  customerPortalTokens   CustomerPortalToken[]
  customerPortalSessions CustomerPortalSession[]

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("customers")
}

model Service {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String
  description     String?
  category        String   @default("General")
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int      @default(60) @map("duration_minutes")
  bufferBefore    Int      @default(0) @map("buffer_before_minutes")
  bufferAfter     Int      @default(0) @map("buffer_after_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  requireDeposit  Boolean  @default(false) @map("require_deposit")
  depositType     String   @default("FIXED") @map("deposit_type")
  depositAmount   Decimal? @map("deposit_amount") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  staffMembers StaffService[]

  @@index([organizationId])
  @@index([organizationId, category])
  @@map("services")
}

model StaffMember {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  userId         String?     @map("user_id")
  name           String
  roleTitle      String      @map("role_title")
  email          String?
  phone          String?
  initials       String
  avatarBg       String      @default("bg-blue-600") @map("avatar_bg")
  status         StaffStatus @default(AVAILABLE)
  tier           StaffTier   @default(FULL_TIME)
  hourlyRate     Decimal?    @map("hourly_rate") @db.Decimal(10, 2)
  commissionRate Decimal?    @map("commission_rate") @db.Decimal(5, 2)
  workingDays    String[]    @default(["MON", "TUE", "WED", "THU", "FRI"]) @map("working_days")
  shiftStart     String      @default("09:00") @map("shift_start")
  shiftEnd       String      @default("17:00") @map("shift_end")
  bio            String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]
  services     StaffService[]
  invitations  OrganizationInvitation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("staff_members")
}

model StaffService {
  id            String   @id @default(uuid())
  staffMemberId String   @map("staff_member_id")
  serviceId     String   @map("service_id")
  createdAt     DateTime @default(now()) @map("created_at")

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, serviceId])
  @@index([staffMemberId])
  @@index([serviceId])
  @@map("staff_services")
}

model Appointment {
  id              String            @id @default(uuid())
  organizationId  String            @map("organization_id")
  customerId      String            @map("customer_id")
  serviceId       String?           @map("service_id")
  staffMemberId   String?           @map("staff_member_id")
  title           String
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(60) @map("duration_minutes")
  status          AppointmentStatus @default(CONFIRMED)
  type            AppointmentType   @default(VIDEO)
  location        String?
  notes           String?
  depositPaid     Boolean           @default(false) @map("deposit_paid")
  depositAmount   Decimal?          @map("deposit_amount") @db.Decimal(10, 2)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staffMember  StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, scheduledAt])
  @@index([customerId])
  @@map("appointments")
}

model Invoice {
  id                   String        @id @default(uuid())
  organizationId       String        @map("organization_id")
  customerId           String        @map("customer_id")
  invoiceNumber        String        @map("invoice_number")
  issueDate            DateTime      @default(now()) @map("issue_date")
  dueDate              DateTime      @map("due_date")
  status               InvoiceStatus @default(PENDING)
  subtotal             Decimal       @db.Decimal(12, 2)
  tax                  Decimal       @default(0) @db.Decimal(12, 2)
  total                Decimal       @db.Decimal(12, 2)
  paidAt               DateTime?     @map("paid_at")
  notes                String?
  paymentToken         String?       @map("payment_token")
  paymentTokenExpiry   DateTime?     @map("payment_token_expiry")
  gatewayProvider      String?       @map("gateway_provider")
  gatewaySessionId     String?       @map("gateway_session_id")
  gatewayPaymentIntent String?       @map("gateway_payment_intent")
  gatewayFee           Decimal?      @map("gateway_fee") @db.Decimal(12, 2)
  netAmount            Decimal?      @map("net_amount") @db.Decimal(12, 2)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items        InvoiceItem[]
  transactions PaymentTransaction[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([paymentToken])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model PaymentTransaction {
  id               String            @id @default(uuid())
  organizationId   String            @map("organization_id")
  invoiceId        String            @map("invoice_id")
  customerId       String            @map("customer_id")
  amount           Decimal           @db.Decimal(12, 2)
  currency         String            @default("USD")
  status           TransactionStatus @default(PENDING)
  provider         String            @default("STRIPE")
  gatewayReference String?           @map("gateway_reference")
  gatewayEventId   String?           @unique @map("gateway_event_id")
  paymentMethod    String?           @map("payment_method")
  failureReason    String?           @map("failure_reason")
  paidAt           DateTime?         @map("paid_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, invoiceId])
  @@index([customerId])
  @@index([gatewayReference])
  @@map("payment_transactions")
}

model OrganizationPaymentSettings {
  id                   String   @id @default(uuid())
  organizationId       String   @unique @map("organization_id")
  stripeAccountId      String?  @map("stripe_account_id")
  stripeConnected      Boolean  @default(false) @map("stripe_connected")
  stripeChargesEnabled Boolean  @default(false) @map("stripe_charges_enabled")
  stripePublishableKey String?  @map("stripe_publishable_key")
  stripeSecretKey      String?  @map("stripe_secret_key")
  stripeWebhookSecret  String?  @map("stripe_webhook_secret")
  isTestMode           Boolean  @default(true) @map("is_test_mode")
  defaultCurrency      String   @default("USD") @map("default_currency")
  allowPartialPayments Boolean  @default(false) @map("allow_partial_payments")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_payment_settings")
}

model OrganizationInvitation {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  email          String
  role           Role     @default(MEMBER)
  tokenHash      String   @unique @map("token_hash")
  inviterId      String   @map("inviter_id")
  staffMemberId  String?  @map("staff_member_id")
  status         String   @default("PENDING")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  staffMember  StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@map("organization_invitations")
}

model WorkspaceAuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  userName       String       @map("user_name")
  action         String
  category       String       @default("SETTINGS")
  details        String
  ipAddress      String?      @map("ip_address")
  createdAt      DateTime     @default(now()) @map("created_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("workspace_audit_logs")
}

model CustomerPortalToken {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  customerId     String    @map("customer_id")
  tokenHash      String    @unique @map("token_hash")
  codeHash       String?   @map("code_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@index([tokenHash])
  @@map("customer_portal_tokens")
}

model CustomerPortalSession {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  customerId     String   @map("customer_id")
  sessionHash    String   @unique @map("session_hash")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  expiresAt      DateTime @map("expires_at")
  lastActiveAt   DateTime @default(now()) @map("last_active_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@index([sessionHash])
  @@index([expiresAt])
  @@map("customer_portal_sessions")
}
